# WhatsApp Translator Bot Configuration

# Target language for translations (ISO 639-1 code)
TARGET_LANGUAGE=en

# Auto-translate incoming messages
AUTO_TRANSLATE=true

# Show original message along with translation
SHOW_ORIGINAL=true

# Translate your replies back to the sender's language
REPLY_IN_ORIGINAL=true

# OpenAI API Key (optional - for AI reply suggestions in future)
# OPENAI_API_KEY=your_api_key_here
